{
  "manifest_version": 3,
  "name": "PoE Trade Bookmark",
  "version": "0.6.0",
  "description": "Path of Exile 1 거래소 검색 결과를 북마크로 저장하고, 아이템을 영문으로 복사합니다.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://www.pathofexile.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://pathofexile.com/trade",
        "https://pathofexile.com/trade/*",
        "https://pathofexile.com/*/trade/*",
        "https://*.pathofexile.com/trade",
        "https://*.pathofexile.com/trade/*",
        "https://*.pathofexile.com/*/trade/*",
        "https://poe.kakaogames.com/trade",
        "https://poe.kakaogames.com/trade/*",
        "https://poe.kakaogames.com/*/trade/*",
        "https://poe.game.daum.net/trade",
        "https://poe.game.daum.net/trade/*",
        "https://poe.game.daum.net/*/trade/*"
      ],
      "js": [
        "trade-url.js",
        "search-summary.js",
        "search-name.js",
        "poe-regex.js",
        "map-mods.js",
        "presets.js",
        "trade-query.js",
        "panel.js",
        "copy-en.js"
      ],
      "css": ["copy-en.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": [
        "https://pathofexile.com/*",
        "https://*.pathofexile.com/*",
        "https://poe.kakaogames.com/*",
        "https://poe.game.daum.net/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

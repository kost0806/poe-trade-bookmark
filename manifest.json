{
  "manifest_version": 3,
  "name": "PoE Trade Bookmark",
  "version": "0.3.0",
  "description": "Path of Exile 1 거래소 검색 결과를 북마크로 저장합니다.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://poe.kakaogames.com/trade/*",
    "https://poe.kakaogames.com/api/trade/*",
    "https://poe.game.daum.net/trade/*",
    "https://poe.game.daum.net/api/trade/*",
    "https://*.pathofexile.com/trade/*",
    "https://*.pathofexile.com/api/trade/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PoE Trade Bookmark 사이드바 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
